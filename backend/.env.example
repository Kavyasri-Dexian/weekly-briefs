# Copy this file to .env (or export these as real shell env vars) and fill in real values.
# Never commit an actual token — .env is gitignored.

# Which narration provider pipeline.py uses. "local" runs a small open-source
# model on this machine (no account, no cost — see scripts/local_infer.py and
# the C:\venv\mlenv setup); "hf" uses Hugging Face's hosted API instead.
# Either way, any failure falls back automatically to the deterministic
# template — the app always works, just with formulaic (but 100% numerically
# accurate) prose if no model draft passes the numeric gate.
NARRATION_PROVIDER=local

# --- local provider settings (only used when NARRATION_PROVIDER=local) ---
# LOCAL_PYTHON=C:\venv\mlenv\Scripts\python.exe
# LOCAL_NARRATION_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# CPU-only generation is slow on this machine — 360s budgets for a full model
# reload + generation per attempt, up to 3 attempts x 2 languages worst case.
# LOCAL_NARRATION_TIMEOUT=360
# LOCAL_MAX_NEW_TOKENS=250

# --- hf provider settings (only used when NARRATION_PROVIDER=hf) ---
# Get a free token at https://huggingface.co/settings/tokens — note HF's free
# tier does not currently serve any capable chat model without paid credits.
HF_TOKEN=
# HF_NARRATION_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional — port the Express server listens on (default 4000).
# PORT=4000
